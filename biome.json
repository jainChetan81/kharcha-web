{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "*.config.ts", "scripts/*.ts", "!src/routeTree.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "preset": "recommended"
      },
      "correctness": {
        "preset": "recommended",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noNestedComponentDefinitions": "error"
      },
      "security": {
        "preset": "recommended"
      },
      "suspicious": {
        "preset": "recommended",
        "noArrayIndexKey": "error",
        "noConsole": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noBarrelFile": "error"
      },
      "complexity": {
        "noUselessFragments": "error",
        "useOptionalChain": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["scripts/**", "src/server/jobs.ts", "src/routes/api.jobs.$name.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/**", "src/routes/**", "src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "error"
          }
        }
      }
    }
  ]
}
