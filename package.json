{
  "name": "kharcha-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc --noEmit && cp -R drizzle .output/",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tooling": "tsc --project tsconfig.tooling.json",
    "unused": "knip",
    "lint": "biome lint . --error-on-warnings",
    "check:db": "node --experimental-strip-types --no-warnings scripts/check-db.ts",
    "check:parsers": "node --experimental-strip-types --no-warnings scripts/check-parsers.ts",
    "quality": "npm run lint && npm run typecheck && npm run typecheck:tooling && npm run unused && npm run check:db && npm run check:format && npm run check:ai && npm run check:wealth && npm run check:parsers",
    "db:generate": "drizzle-kit generate",
    "check:format": "node --experimental-strip-types --no-warnings scripts/check-format.ts",
    "seed:dev": "node --experimental-strip-types --no-warnings scripts/seed-dev.ts",
    "check:ai": "node --experimental-strip-types --no-warnings scripts/check-ai.ts",
    "check:wealth": "node --experimental-strip-types --no-warnings scripts/check-wealth.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.41.0",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "knip": {
    "project": [
      "src/**/*.{ts,tsx}",
      "src/**/*.css",
      "scripts/*.ts"
    ],
    "entry": [
      "scripts/hash-password.ts"
    ],
    "ignoreExportsUsedInFile": true,
    "ignore": [
      "src/server/parsers/**"
    ]
  }
}
